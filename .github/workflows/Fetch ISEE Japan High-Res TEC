name: Fetch ISEE Japan High-Res TEC

on:
  schedule:
    - cron: '17 * * * *'
  workflow_dispatch:

permissions:
  contents: write

concurrency:
  group: fetch-isee-japan-tec
  cancel-in-progress: false

jobs:
  fetch:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: '3.12'
      - name: Install NetCDF dependencies
        run: pip install --disable-pip-version-check numpy xarray netCDF4
      - name: Fetch and crop ISEE TEC
        run: python scripts/fetch_isee_japan_tec.py
      - name: Commit Japan TEC updates
        run: |
          git config user.name "github-actions[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
          git add docs/data/isee_tec
          if git diff --cached --quiet; then
            echo "No ISEE TEC changes"
          else
            git commit -m "data: update ISEE Japan high-res TEC"
            git push
          fi
